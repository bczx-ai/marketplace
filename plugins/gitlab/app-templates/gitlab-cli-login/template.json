{
  "schemaVersion": 1,
  "key": "gitlab-cli-login",
  "name": "GitLab glab 登录",
  "description": "填写 GitLab 地址后登录账号，并为 Agent 配置 glab 命令行访问。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "GLAB_CONFIG_DIR",
    "commands": [
      {
        "command": "glab",
        "args": [
          "auth",
          "login",
          "--hostname",
          { "valueFrom": "config.hostname" },
          "--web",
          "--git-protocol",
          "https"
        ],
        "timeoutSeconds": 600
      }
    ]
  },
  "networkScope": "private",
  "fields": [
    {
      "key": "hostname",
      "type": "text",
      "label": "GitLab 地址",
      "required": true,
      "defaultValue": "https://gitlab.com/",
      "description": "支持完整 HTTP(S) URL 或 hostname，例如 https://gitlab.com/ 或 codebase.example.com。"
    }
  ]
}
