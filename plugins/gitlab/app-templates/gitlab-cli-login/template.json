{
  "schemaVersion": 1,
  "key": "gitlab-cli-login",
  "name": "GitLab 连接",
  "description": "使用 Personal Access Token 连接 GitLab。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "GLAB_CONFIG_DIR",
    "commands": [
      {
        "command": "glab",
        "args": [
          "auth",
          "login",
          "--hostname",
          { "valueFrom": "config.hostname" },
          "--api-protocol",
          { "valueFrom": "config.hostname", "transform": "url_protocol" },
          "--stdin",
          "--git-protocol",
          { "valueFrom": "config.hostname", "transform": "url_protocol" }
        ],
        "stdinFrom": "secret.access_token",
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 120
      },
      {
        "command": "glab",
        "args": [
          "auth",
          "status",
          "--all"
        ],
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 120
      }
    ]
  },
  "networkScope": "private",
  "fields": [
    {
      "key": "hostname",
      "type": "text",
      "label": "GitLab 地址",
      "required": true,
      "defaultValue": "https://gitlab.com",
      "description": "支持 HTTP、HTTPS、端口和子路径，例如 http://gitlab.example.com/code。"
    },
    {
      "key": "access_token",
      "type": "secret",
      "label": "Personal Access Token",
      "required": true,
      "description": "Token 至少需要 api 权限。"
    }
  ]
}
