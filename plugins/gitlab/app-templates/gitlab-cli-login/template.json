{
  "schemaVersion": 1,
  "key": "gitlab-cli-login",
  "name": "GitLab glab 登录",
  "description": "登录 GitLab 账号并为 Agent 配置 glab 命令行访问。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "GLAB_CONFIG_DIR",
    "commands": [
      {
        "command": "glab",
        "args": [
          "auth",
          "login",
          "--hostname",
          { "valueFrom": "config.hostname" },
          "--web",
          "--git-protocol",
          "https"
        ],
        "timeoutSeconds": 600
      }
    ]
  },
  "networkScope": "private",
  "fields": [
    {
      "key": "hostname",
      "type": "text",
      "label": "GitLab Hostname",
      "required": true,
      "defaultValue": "gitlab.com",
      "description": "填写要登录的 GitLab 主机名，例如 gitlab.com 或 gitlab.example.com，不包含协议和路径。"
    }
  ]
}
