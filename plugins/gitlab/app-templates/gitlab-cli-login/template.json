{
  "schemaVersion": 1,
  "key": "gitlab-cli-login",
  "name": "GitLab Token 登录",
  "description": "填写 GitLab 地址和 Personal Access Token，为 Agent 配置 glab 命令行访问。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "GLAB_CONFIG_DIR",
    "commands": [
      {
        "command": "glab",
        "args": [
          "auth",
          "login",
          "--hostname",
          { "valueFrom": "config.hostname" },
          "--stdin",
          "--git-protocol",
          "https"
        ],
        "stdinFrom": "secret.access_token",
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 120
      },
      {
        "command": "glab",
        "args": [
          "auth",
          "status",
          "--hostname",
          { "valueFrom": "config.hostname" }
        ],
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 120
      }
    ]
  },
  "networkScope": "private",
  "fields": [
    {
      "key": "hostname",
      "type": "text",
      "label": "GitLab 地址",
      "required": true,
      "defaultValue": "https://gitlab.com/",
      "description": "支持完整 HTTP(S) URL 或 hostname，例如 https://gitlab.com/ 或 codebase.example.com。"
    },
    {
      "key": "access_token",
      "type": "secret",
      "label": "Personal Access Token",
      "required": true,
      "description": "请在 GitLab 创建至少具有 api 权限的 Token；Brain 仅通过 stdin 传给 glab。"
    }
  ]
}
