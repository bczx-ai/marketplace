{
  "schemaVersion": 1,
  "key": "github-cli-login",
  "name": "GitHub 浏览器登录",
  "description": "保存后自动运行 GitHub 官方 CLI，并打开浏览器完成授权。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "GH_CONFIG_DIR",
    "commands": [
      {
        "command": "gh",
        "args": ["auth", "login", "--hostname", "github.com", "--web", "--git-protocol", "https", "--insecure-storage"],
        "timeoutSeconds": 600
      }
    ]
  },
  "networkScope": "public",
  "fields": []
}
