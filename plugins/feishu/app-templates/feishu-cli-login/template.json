{
  "schemaVersion": 1,
  "key": "feishu-cli-login",
  "name": "飞书账号授权",
  "description": "自动运行飞书官方 CLI，打开一键应用配置和用户授权页面。",
  "auth": {
    "kind": "cli_oauth",
    "configDirEnv": "LARKSUITE_CLI_CONFIG_DIR",
    "commands": [
      {
        "command": "lark-cli",
        "args": ["config", "init", "--new", "--brand", "feishu"],
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 600
      },
      {
        "command": "lark-cli",
        "args": ["auth", "login", "--recommend"],
        "captureAuthorizationUrl": false,
        "timeoutSeconds": 600
      }
    ]
  },
  "networkScope": "public",
  "fields": []
}
