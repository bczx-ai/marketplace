{
  "schemaVersion": 1,
  "key": "devcube-oauth",
  "name": "OAuth2/PKCE",
  "description": "填写 DevCube 服务和 OAuth2 客户端配置后登录授权。",
  "auth": {
    "kind": "oauth2_pkce",
    "authorizationEndpointField": "authorization_endpoint",
    "tokenEndpointField": "token_endpoint",
    "userinfoEndpointField": "userinfo_endpoint",
    "clientIdField": "client_id",
    "clientSecretField": "client_secret",
    "scopes": ["read", "profile"]
  },
  "networkScope": "private",
  "endpointField": "mcp_endpoint",
  "fields": [
    {
      "key": "mcp_endpoint",
      "type": "url",
      "label": "MCP 地址",
      "required": true,
      "description": "DevCube 标准 MCP 服务地址，通常以 /mcp 结尾。"
    },
    {
      "key": "authorization_endpoint",
      "type": "url",
      "label": "OAuth2 授权地址",
      "required": true
    },
    {
      "key": "token_endpoint",
      "type": "url",
      "label": "OAuth2 Token 地址",
      "required": true
    },
    {
      "key": "userinfo_endpoint",
      "type": "url",
      "label": "OAuth2 UserInfo 地址",
      "required": true
    },
    {
      "key": "client_id",
      "type": "text",
      "label": "客户端 ID",
      "required": true
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": "客户端密钥",
      "required": true
    }
  ]
}
