{
  "schemaVersion": 1,
  "key": "devcube-oauth",
  "name": "访问令牌",
  "description": "填写完整的 DevCube API Server 地址和访问令牌后连接。",
  "auth": {
    "kind": "api_key",
    "apiKeyField": "access_token",
    "header": "x-usercenter-session",
    "scopes": []
  },
  "networkScope": "private",
  "endpointField": "cube_api_server",
  "fields": [
    {
      "key": "cube_api_server",
      "type": "url",
      "label": "DevCube API Server 地址",
      "required": true,
      "description": "请输入完整地址：DevCube 域名后加 /cube-api-server，例如 https://cube.anlink.com/cube-api-server。"
    },
    {
      "key": "access_token",
      "type": "secret",
      "label": "访问令牌",
      "required": true,
      "description": "DevCube 访问令牌，仅由 Server 写入 cubelet 配置文件。"
    }
  ],
  "cliConfig": {
    "env": "CUBELET_CONFIG",
    "format": "yaml",
    "content": {
      "cubelet": {
        "server_url": { "valueFrom": "config.cube_api_server" },
        "x-usercenter-session": { "valueFrom": "secret.access_token" },
        "x-service-name": "za-cube",
        "request_timeout": 30
      }
    }
  }
}
