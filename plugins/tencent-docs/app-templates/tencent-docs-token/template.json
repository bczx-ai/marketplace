{
  "schemaVersion": 1,
  "key": "tencent-docs-token",
  "name": "OAuth2 扫码登录",
  "description": "填写腾讯文档开放平台应用凭据后，自动打开官方登录页扫码授权。回调地址必须是 Brain 的 HTTPS 访问地址。",
  "auth": {
    "kind": "oauth2",
    "authorizationEndpoint": "https://docs.qq.com/oauth/v2/authorize",
    "authorizationParams": {
      "new_login": "1",
      "scope": "all"
    },
    "tokenEndpoint": "https://docs.qq.com/oauth/v2/token",
    "tokenMethod": "GET",
    "clientIdField": "client_id",
    "clientSecretField": "client_secret",
    "scopes": []
  },
  "networkScope": "public",
  "endpoint": "https://docs.qq.com/openapi/",
  "fields": [
    {
      "key": "client_id",
      "type": "text",
      "label": "Client ID",
      "required": true,
      "description": "腾讯文档开放平台分配的第三方应用唯一标识。"
    },
    {
      "key": "client_secret",
      "type": "secret",
      "label": "Client Secret",
      "required": true,
      "description": "腾讯文档开放平台分配的应用密钥，仅在 Brain Server 换取和刷新 Token 时使用。"
    }
  ],
  "cliConfig": {
    "env": "TENCENT_DOCS_CONFIG",
    "format": "json",
    "content": {
      "client_id": { "valueFrom": "config.client_id" },
      "access_token": { "valueFrom": "auth.access_token" },
      "open_id": { "valueFrom": "auth.identity.external_id" }
    }
  }
}
